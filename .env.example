# ------------------------------------------------------------------
# MWOA — environment variables
# ------------------------------------------------------------------
# Copy this file to `.env` for local development, and set the same
# variables in Vercel → Project → Settings → Environment Variables for
# production. Never commit real secrets — only this example file.
#
# Everything is OPTIONAL: each feature turns on only when its variables
# are present. Until then the site still works (the order button falls
# back to a pre-filled WhatsApp link, and the AI assistant shows a
# "not enabled" notice).
# ------------------------------------------------------------------

# --- Supabase: persistent order storage (optional) — lib/supabase_storage.js ---
# When BOTH of these are set, orders are stored in the Supabase `orders` table
# instead of the CSV/GitHub backend (all CRUD: create, read, update, delete).
# Leave them blank to keep using data/orders.csv + GitHub.
#
# Project: https://supabase.com/dashboard/project/jkmhofmohkzbkixisqqq
# 1. Run supabase/migrations/0001_orders.sql once (Dashboard → SQL Editor).
# 2. Copy the values from Dashboard → Project Settings → API.
# Project URL (e.g. https://jkmhofmohkzbkixisqqq.supabase.co):
SUPABASE_URL=
# SERVICE ROLE key — server-side only, bypasses RLS. NEVER expose to the browser
# or prefix it with VITE_. Set it only in Vercel env vars / your local .env.
SUPABASE_SERVICE_ROLE_KEY=
# Anon (public) key — optional fallback used only if no service-role key is set.
SUPABASE_ANON_KEY=

# --- Groq: powers BOTH the AI assistant and Prompt Guard 2 ---
# One key from https://console.groq.com/keys  (free tier is fine).
GROQ_API_KEY=
# Assistant chat model (api/assistant.js). Any tool-calling Groq model works.
GROQ_ASSISTANT_MODEL=qwen/qwen3.6-27b
# Prompt Guard 2 — jailbreak / injection screening (lib/guard.js):
GROQ_PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
GROQ_GUARD_THRESHOLD=0.5
# Set to "true" to BLOCK chat when the guard errors (default fails open):
GROQ_GUARD_FAIL_CLOSED=false

# --- WhatsApp order notifications (CallMeBot) — lib/notify.js ---
# Free: send "I allow callmebot to send me messages" to the CallMeBot
# WhatsApp number to get your apikey. See callmebot.com/blog/free-api-whatsapp-messages
# Phone = your number with country code, digits only (e.g. 212631883412):
CALLMEBOT_PHONE=212631883412
CALLMEBOT_APIKEY=

# --- Email order notifications (SMTP via Nodemailer) — lib/notify.js ---
# For Gmail: host smtp.gmail.com, port 587, and an App Password (not your
# normal password) from https://myaccount.google.com/apppasswords
# (EMAIL_* names shown here; SMTP_* names also work.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
# The Gmail account that SENDS the mail (authenticates):
EMAIL_USER=212learn.support@gmail.com
# The 16-char App Password (spaces are stripped automatically):
EMAIL_PASS=
# Inbox that RECEIVES the orders:
ORDER_EMAIL_TO=mazgouraabdalmounim@gmail.com
# "From" address — for Gmail keep this equal to EMAIL_USER (defaults to it):
ORDER_EMAIL_FROM=212learn.support@gmail.com
